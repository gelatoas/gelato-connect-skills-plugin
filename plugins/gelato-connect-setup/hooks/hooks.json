{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/skills/setup/scripts/notice.py || py -3 -I \"${CLAUDE_PLUGIN_ROOT}\"/skills/setup/scripts/notice.py",
            "commandWindows": "py -3 -I -c \"import os,runpy;runpy.run_path(os.environ['CLAUDE_PLUGIN_ROOT']+'/skills/setup/scripts/notice.py',run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
